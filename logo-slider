{% liquid
  assign section_id = section.id
%}

<style>
  .logo-slider-{{ section_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    {% if section.settings.fade_edges %}
      -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    {% endif %}
  }

  .logo-slider-{{ section_id }} .logo-slider__track{
    display:flex;
    align-items:center;
    width:max-content;
    gap:{{ section.settings.gap }}px;
    animation:logo-slider-{{ section_id }} {{ section.settings.speed }}s linear infinite;
  }

  .logo-slider-{{ section_id }} .logo-slider__item{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .logo-slider-{{ section_id }} .logo-slider__item img{
    display:block;
    width:auto;
    height:{{ section.settings.logo_height }}px;
    object-fit:contain;
    transition:transform .3s ease;
  }

  .logo-slider-{{ section_id }} .logo-slider__item:hover img{
    transform:scale(1.05);
  }

  {% if section.settings.pause_hover %}
  .logo-slider-{{ section_id }}:hover .logo-slider__track{
    animation-play-state:paused;
  }
  {% endif %}

  @keyframes logo-slider-{{ section_id }}{
    from{
      transform:translateX(0);
    }
    to{
      transform:translateX(calc(-50% - {{ section.settings.gap | divided_by: 2 }}px));
    }
  }

  @media screen and (max-width:749px){

    .logo-slider-{{ section_id }} .logo-slider__track{
      gap:{{ section.settings.mobile_gap }}px;
    }

    .logo-slider-{{ section_id }} .logo-slider__item img{
      height:{{ section.settings.mobile_logo_height }}px;
    }

  }
</style>

<div class="logo-slider-{{ section_id }}">
  <div class="logo-slider__track" id="logo-track-{{ section_id }}">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="logo-slider__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">
          {% endif %}

          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt }}
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    const track = document.getElementById('logo-track-{{ section_id }}');

    if (!track) return;

    if (track.dataset.initialized) return;

    track.dataset.initialized = true;

    const originals = [...track.children];

    originals.forEach((item) => {
      track.appendChild(item.cloneNode(true));
    });
  })();
</script>

{% schema %}
{
  "name": "Logo Slider",
  "tag": "section",
  "class": "section-logo-slider",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F9FF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Speed (seconds)",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Desktop Logo Height",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_logo_height",
      "label": "Mobile Logo Height",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop Gap",
      "min": 10,
      "max": 120,
      "step": 2,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile Gap",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Fade Edges",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Slider",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
