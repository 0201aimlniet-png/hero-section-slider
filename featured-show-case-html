{{ 'section-feature-showcase-tabs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_active_blocks = false
  for block in section.blocks
    if block.settings.enable
      assign has_active_blocks = true
      break
    endif
  endfor
-%}

<feature-showcase
  class="feature-showcase color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  id="feature-showcase-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="feature-showcase-tabs"
>
  {%- style -%}
        #feature-showcase-{{ section.id }} {
          --fs-bg: {{ section.settings.background_color }};
          --fs-heading-color: {{ section.settings.heading_color }};
          --fs-feature-color: {{ section.settings.feature_text_color }};
          --fs-feature-active-color: {{ section.settings.active_feature_color }};
          --fs-button-bg: {{ section.settings.button_bg_color }};
          --fs-button-text: {{ section.settings.button_text_color }};
          --fs-button-bg-hover: {{ section.settings.button_bg_color | color_mix: '#000000', 85 }};
          --fs-section-radius: {{ section.settings.section_radius }}px;
          --fs-content-padding-x: {{ section.settings.content_padding_x }}px;
          --fs-content-padding-top: {{ section.settings.content_padding_top }}px;
          --fs-content-padding-bottom: {{ section.settings.content_padding_bottom }}px;
          --fs-content-padding-x-mobile: {{ section.settings.content_padding_x_mobile }}px;
    --fs-content-padding-top-mobile: {{ section.settings.content_padding_top_mobile }}px;
    --fs-content-padding-bottom-mobile: {{ section.settings.content_padding_bottom_mobile }}px;
          --fs-panel-bg: {{ section.settings.background_color | color_mix: '#000000', 92 }};
        }

        .section-{{ section.id }}-padding {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        margin-top: {{ section.settings.margin_top_mobile }}px;
        margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  {%- endstyle -%}

  <div class="feature-showcase__container page-width">
    {%- if has_active_blocks -%}
      <div class="feature-showcase__grid">
        <!-- Left column: heading, feature tab list, CTA -->
        <div class="feature-showcase__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="feature-showcase__heading">
              {{
                section.settings.heading
                | replace: '<p>', ''
                | replace: '</p>', ''
                | replace: '<h1>', ''
                | replace: '</h1>', ''
                | replace: '<h2>', ''
                | replace: '</h2>', ''
                | replace: '<h3>', ''
                | replace: '</h3>', ''
              }}
            </h2>
          {%- endif -%}

          <div
            class="feature-showcase__tablist"
            role="tablist"
            aria-label="{{ section.settings.heading | strip_html | escape }}"
          >
            {%- for block in section.blocks -%}
              {%- if block.settings.enable -%}
                <button
                  type="button"
                  class="feature-showcase__tab{% if forloop.first %} is-active{% endif %}"
                  id="fs-tab-{{ section.id }}-{{ forloop.index0 }}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="fs-panel-{{ section.id }}-{{ forloop.index0 }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-fs-index="{{ forloop.index0 }}"
                  style="--fs-delay: {{ forloop.index0 | times: 60 }}ms"
                  {{ block.shopify_attributes }}
                >
                  <span class="feature-showcase__tab-indicator" aria-hidden="true"></span>

                  {%- if block.settings.icon != blank -%}
                    <span class="feature-showcase__icon">
                      {{
                        block.settings.icon
                        | image_url: width: 48
                        | image_tag:
                          loading: 'lazy',
                          width: 24,
                          height: 24,
                          alt: '',
                          class: 'feature-showcase__icon-img'
                      }}
                    </span>
                  {%- endif -%}

                  <span class="feature-showcase__arrow" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>

                  <span class="feature-showcase__tab-text">
                    <span class="feature-showcase__title">{{ block.settings.title }}</span>
                    {%- if block.settings.description != blank -%}
                      <span class="feature-showcase__description">{{ block.settings.description }}</span>
                    {%- endif -%}
                  </span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if section.settings.button_text != blank -%}
            <a
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="feature-showcase__button"
            >
              {{ section.settings.button_text }}
            </a>
          {%- endif -%}
        </div>

        <!-- Right column: crossfading preview image -->
        <div class="feature-showcase__media">
          <div class="feature-showcase__media-inner">
            {%- for block in section.blocks -%}
              {%- if block.settings.enable -%}
                <div
                  class="feature-showcase__panel{% if forloop.first %} is-active{% endif %}"
                  id="fs-panel-{{ section.id }}-{{ forloop.index0 }}"
                  role="tabpanel"
                  aria-labelledby="fs-tab-{{ section.id }}-{{ forloop.index0 }}"
                  data-fs-index="{{ forloop.index0 }}"
                  {% unless forloop.first %}
                    hidden
                  {% endunless %}
                >
                  {%- if block.settings.image -%}
                    {%- liquid
                      if forloop.first
                        assign fs_loading = 'eager'
                        assign fs_fetchpriority = 'high'
                      else
                        assign fs_loading = 'lazy'
                        assign fs_fetchpriority = 'auto'
                      endif
                      assign fs_alt = block.settings.title | escape
                    -%}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        loading: fs_loading,
                        fetchpriority: fs_fetchpriority,
                        widths: '375, 750, 1100, 1500, 1600',
                        sizes: '(min-width: 990px) 58vw, (min-width: 750px) 55vw, 100vw',
                        alt: fs_alt,
                        class: 'feature-showcase__image'
                    }}
                  {%- else -%}
                    {{
                      'lifestyle-1'
                      | placeholder_svg_tag: 'feature-showcase__image feature-showcase__image--placeholder'
                    }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="feature-showcase__placeholder">
        {{
          'collection-apparel-1'
          | placeholder_svg_tag: 'feature-showcase__image feature-showcase__image--placeholder'
        }}
        <p>Add feature blocks to get started.</p>
      </div>
    {%- endif -%}
  </div>
</feature-showcase>

<script src="{{ 'feature-showcase-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Feature showcase tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Modern Design Features, Our Themes Have</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3EFFB"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Feature text color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "active_feature_color",
      "label": "Active feature color",
      "default": "#1F1B8C"
    },
    
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#1F1B8C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Section corner radius",
      "info": "Rounds the outer corners of the whole section card (text panel + image).",
      "default": 24
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "content_padding_x",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Left/right padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_x_mobile",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Left/right padding (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top margin (desktop)",
      "info": "Space above the section, separate from the card's own padding.",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom margin (desktop)",
      "info": "Space below the section, separate from the card's own padding.",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable",
          "label": "Enable this feature",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Mega-menu"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description (optional)",
          "info": "Reserved for future use — not shown in the current layout unless your theme design calls for it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature showcase tabs",
      "blocks": [
        { "type": "feature", "settings": { "title": "Mega-menu" } },
        { "type": "feature", "settings": { "title": "Countdown Timer" } },
        { "type": "feature", "settings": { "title": "Quick View" } },
        { "type": "feature", "settings": { "title": "Sticky Header" } },
        { "type": "feature", "settings": { "title": "Color Swatches" } },
        { "type": "feature", "settings": { "title": "Account Menu" } },
        { "type": "feature", "settings": { "title": "Before / After Slider" } },
        { "type": "feature", "settings": { "title": "Breadcrumbs" } }
      ]
    }
  ]
}
{% endschema %}
